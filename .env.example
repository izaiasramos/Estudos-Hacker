# Segredo da sessão. Em produção é obrigatório.
AUTH_SECRET=

# OAuth Google. Sem estes valores o botão avisa que falta configuração.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres local. Sobe com docker compose up -d.
DATABASE_URL=postgres://shieldpath:shieldpath@localhost:5432/shieldpath

# Laboratório da pizzaria. Omita para o app embutido (/lab/pizzaria), que funciona na Vercel.
# LAB_RUNTIME=local
